package view

import "main/pkg/view/htmx"

script ChangePasswordAlpine() {
    document.addEventListener("alpine:init", () => {
        Alpine.data("ChangePassword", () => ({
            error: { pwd: null, confirm: null },
            pwd: {
                value: "", 
                confirm: "", 
                reg: /^(?=.*[A-Z])(?=.*\d).{8,}$/,
                error: "Fill your password",
                confirmError: "Passwords do not match",
            }
        }))
    })
}

templ ChangePassword(Email string, Token string) {
    @ChangePasswordAlpine()
    <div class="w-full flex justify-center items-center"
         x-data='ChangePassword'>
        <form class="w-[300px] flex flex-col gap-5" { htmx.PostLink("/auth/password", "")... }>
            <input class="hidden" type="text" name="Email" value={Email} />
            <input class="hidden" type="text" name="Token" value={Token} />

            <span class="text-3xl text-center font-nino font-bold text-primary">შექმენი ახალი პაროლი</span>

            <div role='password' class="form-control mt-4" 
                    x-effect='error.pwd = pwd.value && !pwd.reg.test(pwd.value) ? pwd.error : null'>
                <label class="label">
                    <span class="label-text">Password</span>
                </label>
                <label  class="input input-bordered flex items-center gap-2" 
                        :class='error.pwd == pwd.error && "border-red-600 border-dotted border-2"'>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path fill-rule="evenodd" d="M14 6a4 4 0 0 1-4.899 3.899l-1.955 1.955a.5.5 0 0 1-.353.146H5v1.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2.293a.5.5 0 0 1 .146-.353l3.955-3.955A4 4 0 1 1 14 6Zm-4-2a.75.75 0 0 0 0 1.5.5.5 0 0 1 .5.5.75.75 0 0 0 1.5 0 2 2 0 0 0-2-2Z" clip-rule="evenodd" /></svg>
                    <input required x-model='pwd.value' name="Password" type="password" class="grow" placeholder="Enter password" />
                </label>
                <label class="label">
                    <span class="label-text text-gray-500">Password must be at least 8 characters long and contain at least one uppercase letter and one number</span>
                </label>
            </div>

            <div role='confirm' class="form-control "
                    x-effect='error.confirm = pwd.confirm && pwd.confirm != pwd.value ? pwd.confirmError : null'>
                <label class="label">
                    <span class="label-text">Confirm Password</span>
                </label>
                <label  class="input input-bordered flex items-center gap-2" 
                        :class='error.confirm == pwd.confirmError && "border-red-600 border-dotted border-2"'>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path fill-rule="evenodd" d="M14 6a4 4 0 0 1-4.899 3.899l-1.955 1.955a.5.5 0 0 1-.353.146H5v1.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2.293a.5.5 0 0 1 .146-.353l3.955-3.955A4 4 0 1 1 14 6Zm-4-2a.75.75 0 0 0 0 1.5.5.5 0 0 1 .5.5.75.75 0 0 0 1.5 0 2 2 0 0 0-2-2Z" clip-rule="evenodd" /></svg>
                    <input required x-model='pwd.confirm' type="password" class="grow" autocomplete="new-password" placeholder="Confirm password" />
                </label>
            </div>

            <button type="submit" class="w-full btn rounded-box bg-primary text-white" 
                    x-bind:disabled='!pwd.value || !pwd.confirm || error.pwd || error.confirm'>
                    შექმნა
            </button>
        </form>
    </div>
}

templ ForgotPassword() {
    <div class="w-full flex justify-center items-center">
        <form class="w-[300px] flex flex-col gap-5"
              { htmx.PostLink("/auth/forgot", "")... }>
            <span class="w-full text-3xl font-nino font-bold text-primary">პაროლის აღდგენა</span>

            <input  class="w-full input input-bordered max-w-xs rounded-box" 
                    name="Email" type="email" placeholder="ელ ფოსტა" />

            <button type="submit" class="btn w-full bg-primary text-white rounded-box">პაროლის აღდგენა</button>
        </form>
    </div>
}

templ ForgotPasswordSuccess() {
    <div class="w-full flex justify-center items-center h-[30vh]">
        <span class="w-full text-center text-3xl font-nino font-bold text-primary">შეამოწმეთ თქვენი ელ ფოსტა</span>
    </div>
}